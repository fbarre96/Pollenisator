# Example .env configuration for Google Workspace Authentication
# Copy this to your .env file and fill in your values

# ============================================
# EXISTING POLLENISATOR CONFIGURATION
# ============================================

MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_SSL=False
MONGODB_USER=
MONGODB_PASSWORD=

POLLENISATOR_BIND_IP=0.0.0.0
POLLENISATOR_PORT=5000
POLLENISATOR_SSL=False
POLLENISATOR_KNOWLEDGE_API_URL=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

MARKDOWN_MERMAID_CLI=mmdc

# Flask Configuration
FLASK_DEBUG=False  # Set to False in production!

# JWT Secret (generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))")
# JWT_SECRET=your-secret-here

# ============================================
# GOOGLE WORKSPACE OAUTH CONFIGURATION
# ============================================

# Google OAuth 2.0 Client ID
# Get this from Google Cloud Console > APIs & Services > Credentials
# Example: 123456789-abcdefg.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# Google OAuth 2.0 Client Secret
# Get this from Google Cloud Console > APIs & Services > Credentials
# Keep this secret! Never commit to version control.
GOOGLE_CLIENT_SECRET=

# OAuth Redirect URI
# This must exactly match what you configured in Google Cloud Console
# For local development:
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback
# For production (uncomment and update):
# GOOGLE_REDIRECT_URI=https://your-domain.com/api/v1/auth/google/callback

# Google Workspace Domain Restriction (Optional)
# If set, only users with email addresses from this domain can authenticate
# Example: example.com (only user@example.com can login)
# Leave empty to allow any Google account
GOOGLE_WORKSPACE_DOMAIN=

# ============================================
# NOTES FOR OPEN SOURCE DEPLOYMENTS
# ============================================

# 1. Each deployment MUST create its own Google Cloud Project
# 2. Obtain your own OAuth 2.0 credentials from Google Cloud Console
# 3. NEVER commit credentials to version control
# 4. Use different credentials for dev/staging/production environments
# 5. Rotate secrets regularly
# 6. Enable domain restriction for organizational deployments

# See docs/GOOGLE_WORKSPACE_AUTH.md for detailed setup instructions
